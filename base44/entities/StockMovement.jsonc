{
  "name": "StockMovement",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "product_id": {
      "type": "string"
    },
    "product_name": {
      "type": "string"
    },
    "variant_size": {
      "type": "string"
    },
    "variant_color": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "ajuste"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o"
    },
    "quantity": {
      "type": "number"
    },
    "reason": {
      "type": "string",
      "description": "Motivo da movimenta\u00e7\u00e3o"
    },
    "sale_id": {
      "type": "string",
      "description": "ID da venda relacionada"
    }
  },
  "required": [
    "product_id",
    "type",
    "quantity"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}