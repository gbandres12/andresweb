{
  "name": "ConciliationEntry",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "source": {
      "type": "string",
      "enum": [
        "banco",
        "cartao"
      ],
      "description": "Origem: extrato banc\u00e1rio ou adquirente de cart\u00e3o"
    },
    "file_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "amount": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "fitid": {
      "type": "string",
      "description": "Identificador \u00fanico da transa\u00e7\u00e3o no arquivo"
    },
    "type": {
      "type": "string",
      "enum": [
        "receita",
        "despesa"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "conciliado",
        "ignorado"
      ],
      "default": "pendente"
    },
    "matched_transaction_id": {
      "type": "string",
      "description": "Transaction conciliada, se houver"
    },
    "matched_amount": {
      "type": "number"
    }
  },
  "required": [
    "source",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}