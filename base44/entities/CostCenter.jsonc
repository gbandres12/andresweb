{
  "name": "CostCenter",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "name": {
      "type": "string",
      "description": "Nome do centro de custo"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do centro de custo"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do centro de custo"
    },
    "responsible_name": {
      "type": "string",
      "description": "Respons\u00e1vel pelo centro de custo"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Centro de custo ativo"
    },
    "parent_id": {
      "type": "string",
      "description": "Centro de custo pai (hierarquia)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}