{
  "name": "Sale",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "sale_number": {
      "type": "string",
      "description": "N\u00famero da venda"
    },
    "items": {
      "type": "array",
      "description": "Itens da venda",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_size": {
            "type": "string"
          },
          "variant_color": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "price_table": {
      "type": "string",
      "enum": [
        "cliente_final",
        "atacado",
        "revenda"
      ],
      "description": "Tabela de pre\u00e7o aplicada na venda"
    },
    "sales_channel": {
      "type": "string",
      "enum": [
        "Loja F\u00edsica",
        "WhatsApp",
        "Instagram",
        "Facebook",
        "Site / E-commerce",
        "Telefone",
        "Indica\u00e7\u00e3o",
        "Feira / Evento",
        "Outros"
      ],
      "description": "Canal de origem da venda (para relat\u00f3rios por canal)"
    },
    "subtotal": {
      "type": "number"
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "Dinheiro",
        "PIX",
        "Cart\u00e3o",
        "Cr\u00e9dito da loja"
      ],
      "description": "M\u00e9todo de pagamento"
    },
    "payment_details": {
      "type": "string",
      "description": "Detalhes do pagamento"
    },
    "customer_id": {
      "type": "string",
      "description": "Cliente vinculado"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "seller_name": {
      "type": "string",
      "description": "Vendedor / caixa"
    },
    "consultant_name": {
      "type": "string",
      "description": "Consultor que atendeu o cliente"
    },
    "status": {
      "type": "string",
      "enum": [
        "concluida",
        "cancelada",
        "pendente"
      ],
      "default": "concluida"
    },
    "sale_type": {
      "type": "string",
      "enum": [
        "venda",
        "consignacao"
      ],
      "default": "venda",
      "description": "Tipo: venda comum ou consigna\u00e7\u00e3o"
    },
    "consignment_status": {
      "type": "string",
      "enum": [
        "em_consignacao",
        "liquidada",
        "devolvida",
        "parcial"
      ],
      "description": "Status da consigna\u00e7\u00e3o"
    },
    "consignee_name": {
      "type": "string",
      "description": "Consignat\u00e1rio (quem recebe as pe\u00e7as em consigna\u00e7\u00e3o)"
    },
    "consignment_due_date": {
      "type": "string",
      "format": "date",
      "description": "Data limite para liquida\u00e7\u00e3o/devolu\u00e7\u00e3o da consigna\u00e7\u00e3o"
    },
    "consignment_payments": {
      "type": "array",
      "description": "Pagamentos parciais da consigna\u00e7\u00e3o (parcelas)",
      "items": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "consignment_paid": {
      "type": "number",
      "default": 0,
      "description": "Total j\u00e1 pago da consigna\u00e7\u00e3o"
    }
  },
  "required": [
    "items",
    "total"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}