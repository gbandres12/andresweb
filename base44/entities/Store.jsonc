{
  "name": "Store",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da loja"
    },
    "type": {
      "type": "string",
      "enum": [
        "loja",
        "deposito"
      ],
      "default": "loja",
      "description": "Tipo: loja (venda) ou deposito (estoque central / CD)"
    },
    "slug": {
      "type": "string",
      "description": "Identificador \u00fanico da loja na plataforma"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "starter",
        "pro",
        "enterprise"
      ],
      "default": "free",
      "description": "Plano da assinatura"
    },
    "status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "suspended",
        "cancelled"
      ],
      "default": "trial",
      "description": "Status da loja na plataforma"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ da loja"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "primary_color": {
      "type": "string",
      "description": "Cor principal da marca (hex)"
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date"
    },
    "settings": {
      "type": "object",
      "description": "Configura\u00e7\u00f5es diversas da loja"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}