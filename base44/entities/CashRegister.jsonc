{
  "name": "CashRegister",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "fechado"
      ],
      "default": "aberto",
      "description": "Status do caixa"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de abertura"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de fechamento"
    },
    "opened_by_name": {
      "type": "string",
      "description": "Quem abriu o caixa"
    },
    "closed_by_name": {
      "type": "string",
      "description": "Quem fechou o caixa"
    },
    "opening_balance": {
      "type": "number",
      "default": 0,
      "description": "Fundo de troco na abertura"
    },
    "closing_balance": {
      "type": "number",
      "default": 0,
      "description": "Total contado no fechamento"
    },
    "expected_dinheiro": {
      "type": "number",
      "default": 0,
      "description": "Dinheiro esperado (abertura + vendas + suprimentos - sangrias)"
    },
    "expected_pix": {
      "type": "number",
      "default": 0,
      "description": "PIX esperado"
    },
    "expected_cartao": {
      "type": "number",
      "default": 0,
      "description": "Cart\u00e3o esperado"
    },
    "expected_consignado": {
      "type": "number",
      "default": 0,
      "description": "Consignado esperado (vendas em consigna\u00e7\u00e3o do per\u00edodo)"
    },
    "counted_dinheiro": {
      "type": "number",
      "default": 0,
      "description": "Dinheiro contado pela operadora no fechamento"
    },
    "counted_pix": {
      "type": "number",
      "default": 0,
      "description": "PIX contado no fechamento"
    },
    "counted_cartao": {
      "type": "number",
      "default": 0,
      "description": "Cart\u00e3o contado no fechamento"
    },
    "counted_consignado": {
      "type": "number",
      "default": 0,
      "description": "Consignado declarado no fechamento"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es do fechamento (ex: faltas/sobras)"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}