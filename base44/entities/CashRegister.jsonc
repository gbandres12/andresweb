{
  "name": "CashRegister",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "fechado"
      ],
      "default": "aberto",
      "description": "Status do caixa"
    },
    "opened_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de abertura"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de fechamento"
    },
    "opened_by_name": {
      "type": "string",
      "description": "Quem abriu o caixa"
    },
    "closed_by_name": {
      "type": "string",
      "description": "Quem fechou o caixa"
    },
    "opening_balance": {
      "type": "number",
      "default": 0,
      "description": "Fundo de troco na abertura"
    },
    "closing_balance": {
      "type": "number",
      "default": 0,
      "description": "Saldo final no fechamento"
    },
    "expected_dinheiro": {
      "type": "number",
      "default": 0
    },
    "expected_pix": {
      "type": "number",
      "default": 0
    },
    "expected_cartao": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}