{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}