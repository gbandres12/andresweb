{
  "name": "Customer",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "name": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "description": "Telefone principal de contato"
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp / n\u00famero para receber SMS de promo\u00e7\u00f5es e disparos"
    },
    "email": {
      "type": "string"
    },
    "cpf": {
      "type": "string"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "marketing_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Aceita receber promo\u00e7\u00f5es e disparos (consentimento LGPD)"
    },
    "marketing_channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "sms",
        "ambos"
      ],
      "default": "whatsapp",
      "description": "Canal preferido para campanhas"
    },
    "total_purchases": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}