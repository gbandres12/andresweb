{
  "name": "Product",
  "type": "object",
  "properties": {
    "store_id": {
      "type": "string",
      "description": "ID da loja (multi-tenant)"
    },
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "category": {
      "type": "string",
      "description": "Nome da categoria (refer\u00eancia \u00e0 entidade Category cadastrada pela loja)"
    },
    "reference": {
      "type": "string",
      "description": "Refer\u00eancia Fernanda \u2014 c\u00f3digo da categoria + pre\u00e7o de venda em centavos (ex.: 0490)"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o de venda base"
    },
    "price_tables": {
      "type": "object",
      "description": "Ajuste percentual por tabela de pre\u00e7o em rela\u00e7\u00e3o ao pre\u00e7o base",
      "properties": {
        "cliente_final": {
          "type": "number",
          "default": 0
        },
        "atacado": {
          "type": "number",
          "default": -10
        },
        "revenda": {
          "type": "number",
          "default": -5
        }
      }
    },
    "active_tables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tabelas de pre\u00e7o nas quais o produto participa (vazio = participa de todas)"
    },
    "cost_price": {
      "type": "number",
      "description": "Pre\u00e7o de custo"
    },
    "sku": {
      "type": "string",
      "description": "SKU / c\u00f3digo interno do produto"
    },
    "gtin": {
      "type": "string",
      "description": "C\u00f3digo de barras GTIN/EAN do produto (para leitores USB e etiquetas)"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das imagens"
    },
    "variants": {
      "type": "array",
      "description": "Variantes do produto (tamanho + cor + estoque)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "stock": {
            "type": "number"
          },
          "sku": {
            "type": "string"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Produto ativo no cat\u00e1logo"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Destaque no cat\u00e1logo online"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.store_id": "{{user.data.store_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}