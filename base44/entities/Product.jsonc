{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do produto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "category": {
      "type": "string",
      "enum": [
        "Vestidos",
        "Blusas",
        "Cal\u00e7as",
        "Saias",
        "Shorts",
        "Casacos",
        "Acess\u00f3rios",
        "Moda Praia",
        "Lingerie",
        "Outros"
      ],
      "description": "Categoria do produto"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o de venda"
    },
    "cost_price": {
      "type": "number",
      "description": "Pre\u00e7o de custo"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das imagens"
    },
    "variants": {
      "type": "array",
      "description": "Variantes do produto (tamanho + cor + estoque)",
      "items": {
        "type": "object",
        "properties": {
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "stock": {
            "type": "number"
          },
          "sku": {
            "type": "string"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Produto ativo no cat\u00e1logo"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Destaque no cat\u00e1logo online"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags para busca"
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ]
}