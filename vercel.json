{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/classify-photo",
      "destination": "/api/classify-photo.js"
    },
    {
      "source": "/api/import-ai",
      "destination": "/api/import-ai.js"
    },
    {
      "source": "/api/integrations/import-ai",
      "destination": "/api/import-ai.js"
    },
    {
      "source": "/api/entities/(.*)",
      "destination": "/api/entities/index.js"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
